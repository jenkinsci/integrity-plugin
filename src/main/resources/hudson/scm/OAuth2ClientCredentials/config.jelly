<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="ID" field="id">
    <f:textbox default="${descriptor.getDefaultId()}" />
    <f:help>
      Optional. Leave blank for a random ID, or specify a custom one for easier reference.
    </f:help>
  </f:entry>
	  <f:entry title="Description" field="description">
    <f:textbox/>
  </f:entry>
  <f:entry title="Client ID" field="clientId" required="true">
    <f:textbox/>
  </f:entry>
  <f:entry title="Client Secret" field="clientSecret" required="true">
    <f:password/>
  </f:entry>
  <f:entry title="Token Endpoint" field="tokenEndpoint" required="true">
    <f:textbox/>
  </f:entry>
  <f:entry title="Scope" field="oAuthScope" required="true">
    <f:textbox/>
  </f:entry>
</j:jelly>
