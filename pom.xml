  </dependencies>

  <build>
    <plugins>
      <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-enforcer-plugin</artifactId>
      <executions>
      <execution>
      <id>display-info</id>
      <goals>
      <goal>enforce</goal>
      </goals>
      <configuration>
      <rules>
      <enforceBytecodeVersion>
      <excludes>
      <exclude>io.github.ptc-alm:mksapi-jar</exclude>
      </excludes>
      </enforceBytecodeVersion>
      </rules>
      </configuration>
      </execution>
      </executions>
      </plugin>
      <!-- Mandatory: compile for Java 21 (replaces old 1.7 settings) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>

      <!-- Keep HPI plugin config as-is -->
      <plugin>
        <groupId>org.jenkins-ci.tools</groupId>
        <artifactId>maven-hpi-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <compatibleSinceVersion>1.29</compatibleSinceVersion>
        </configuration>
      </plugin>

      <!-- Kept: surefire skip config (unchanged) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <!-- Kept: javadoc and older configs, optional clean-up later -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <additionalparam>-Xdoclint:none</additionalparam>
        </configuration>
      </plugin>
		
		 <!-- spotbugs -->
	<plugin>
	  <groupId>com.github.spotbugs</groupId>
	  <artifactId>spotbugs-maven-plugin</artifactId>
	  <version>4.9.8.2</version>
	  <configuration>
	    <failOnError>false</failOnError>
	    <!-- optional: only report High/Medium -->
	    <!-- <threshold>High</threshold> -->
	  </configuration>
	  <!-- Optional: define a non-failing execution -->
	  <executions>
	    <execution>
	      <id>spotbugs-analysis</id>
	      <goals>
	        <goal>spotbugs</goal> <!-- generate report -->
	      </goals>
	      <!-- (omit 'check' goal if you don't want failure) -->
	    </execution>
	  </executions>
	</plugin>

      <!-- Kept: release plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>2.5.1</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.shared</groupId>
            <artifactId>maven-invoker</artifactId>
            <version>2.2</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <uniqueVersion>false</uniqueVersion>
      <id>maven.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/releases/</url>
    </repository>
    <snapshotRepository>
      <id>maven.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <repositories>
    <repository>
      <id>maven.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>maven.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
