  <modelVersion>4.0.0</modelVersion>

  <!-- Mandatory: move to plugin-pom 6.x (Java 21, Jenkins >= 2.516) -->
  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>5.31</version>
    <relativePath />
  </parent>

  <artifactId>integrity-plugin</artifactId>
  <name>PTC RV&amp;S CM - Jenkins Plugin</name>
  <description>Integrates Jenkins with PTC RV&amp;S</description>
  <version>2.8-SNAPSHOT</version>
  <packaging>hpi</packaging>
  <url>https://github.com/jenkinsci/integrity-plugin</url>

  <developers>
    <developer>
      <id>PTC_Integrity_Support</id>
      <name>PTC Integrity Support Team</name>
      <email>integrity_jenkins_plugin@ptc.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:ssh://github.com/jenkinsci/integrity-plugin.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/jenkinsci/integrity-plugin.git</developerConnection>
    <url>https://github.com/jenkinsci/integrity-plugin</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Mandatory: Jenkins core baseline that supports Java 21 and matches parent 6.x -->
    <jenkins.version>2.516.3</jenkins.version>

    <!-- Removed (mandatory cleanup): java.level is obsolete with modern parent -->
    <!-- Removed (left as-is otherwise): workflow.version.* left untouched for now -->
    <workflow.version>1.14.2</workflow.version>
  </properties>

